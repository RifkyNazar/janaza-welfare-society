DATABASE_URL="mysql://app_user:replace-with-strong-password@127.0.0.1:3306/jws"

# Optional absolute persistent directory outside the application release/public tree.
# Leave unset locally to use .data/public-media. Do not expose this through nginx.
# JWS_MEDIA_DIRECTORY=/var/lib/jws/public-media
AUTH_SECRET="replace-with-a-long-random-secret"
# Separate stable secret for employee PIN hashing and rate-limit keys. Generate 32 random bytes.
EMPLOYEE_PIN_PEPPER=""
# Required for self-hosted production. Set the canonical HTTPS origin without a path.
# Use the local origin and port when testing with next start on localhost.
# AUTH_URL="https://jws.example.org"

SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="smtp-account@example.com"
SMTP_PASS="replace-with-smtp-app-password"
EMAIL_FROM="Janaza Welfare Society <smtp-account@example.com>"
APP_BASE_URL="http://localhost:3000"

TEXTLK_API_TOKEN="YOUR_TEXTLK_API_TOKEN"
TEXTLK_SENDER_ID="YOUR_APPROVED_SENDER_ID"
SMS_NOTIFICATIONS_ENABLED="false"

# Generate the VAPID key pair with: npx web-push generate-vapid-keys
# The public key is safe for browser code. Keep the private key server-only.
NEXT_PUBLIC_WEB_PUSH_VAPID_PUBLIC_KEY="replace-with-vapid-public-key"
WEB_PUSH_VAPID_PRIVATE_KEY="replace-with-vapid-private-key"
WEB_PUSH_VAPID_SUBJECT="mailto:admin@example.com"
