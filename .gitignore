# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
*.key
id_rsa
id_ed25519
/credentials.json

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local databases and backups
*.db
*.sqlite
*.sqlite3
*.bak
*.sql.gz
/backup.sql
/dump.sql
/backups/
/dumps/

# Runtime uploads are private deployment data, not source files.
/.data/
/uploads/
/public/uploads/

# The client in /generated/prisma is checked in; this excludes the old output path.
/app/generated/prisma
