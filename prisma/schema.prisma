generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum UserRole {
  ADMIN
  SUPERVISOR
  EMPLOYEE
}

enum EmployeeAvailability {
  AVAILABLE
  UNAVAILABLE
}

enum AccountStatus {
  PENDING
  APPROVED
  REJECTED
  DISABLED
}

enum ServiceRequestStatus {
  NEW
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ServiceCategory {
  JANAZAH
  VEHICLE
}

enum PlaceType {
  HOME
  HOSPITAL
  OTHER
}

enum TaskStatus {
  ASSIGNED
  ACKNOWLEDGED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum DonationStatus {
  PENDING
  VERIFIED
  REJECTED
}

model User {
  id                 Int              @id @default(autoincrement())
  email              String           @unique
  passwordHash       String
  role               UserRole         @default(EMPLOYEE)
  status             AccountStatus    @default(PENDING)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  employeeProfile    EmployeeProfile?
  taskPhotosReviewed TaskPhoto[]      @relation("TaskPhotoReviewer")
  donationsReviewed  Donation[]       @relation("DonationReviewer")
  assignmentsCreated TaskAssignment[] @relation("TaskAssignedBy")
}

model EmployeeProfile {
  id              Int              @id @default(autoincrement())
  userId          Int              @unique
  employeeCode    String           @unique
  fullName        String
  phone           String
  position        String
  duty            String?
  photoUrl        String?
  isPublicProfile Boolean          @default(false)
  availability    EmployeeAvailability @default(AVAILABLE)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  user            User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  taskAssignments TaskAssignment[]
}

model ServiceRequest {
  id                     Int                  @id @default(autoincrement())
  requestCode            String               @unique
  requesterName          String
  mobileNumber           String
  alternativeNumber      String?
  relationshipToDeceased String?
  serviceType            String
  requiredDate           DateTime
  requiredTime           String?
  placeType              PlaceType
  address                String
  area                   String
  locationLink           String?
  latitude               Float?
  longitude              Float?
  hospitalName           String?
  note                   String?
  status                 ServiceRequestStatus @default(NEW)
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  taskAssignments        TaskAssignment[]
  preferredVehicleId     String?
  preferredVehicle       Vehicle?              @relation(fields: [preferredVehicleId], references: [id], onDelete: SetNull)
  serviceCategory        ServiceCategory?
  serviceSelections      RequestServiceSelection[]

  @@index([status])
  @@index([createdAt])
  @@index([area])
  @@index([preferredVehicleId])
}

model RequestServiceSelection {
  id           Int            @id @default(autoincrement())
  requestId    Int
  serviceCode  String         @db.VarChar(64)
  serviceLabel String         @db.VarChar(120)
  createdAt    DateTime       @default(now())
  request      ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)

  @@unique([requestId, serviceCode])
  @@index([requestId])
  @@index([serviceCode])
}

model Vehicle {
  id                String           @id @default(cuid())
  name              String
  vehicleNumber     String           @unique
  vehicleType       String
  description       String?          @db.Text
  imageUrl          String?
  isActive          Boolean          @default(true)
  isPublic          Boolean          @default(false)
  displayOrder      Int              @default(0)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  preferredRequests ServiceRequest[]

  @@index([isActive, isPublic])
  @@index([displayOrder])
}

model Donation {
  id                Int            @id @default(autoincrement())
  referenceCode     String         @unique
  fullName          String
  mobileNumber      String
  amount            Decimal        @db.Decimal(12, 2)
  transferDate      DateTime
  bankReference     String?
  note              String?        @db.Text
  receiptFileName   String
  receiptStorageKey String
  receiptMimeType   String
  status            DonationStatus @default(PENDING)
  reviewedAt        DateTime?
  reviewedByUserId  Int?
  reviewNote        String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  reviewedBy        User?          @relation("DonationReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([createdAt])
  @@index([mobileNumber])
  @@index([reviewedByUserId])
}

model TaskAssignment {
  id                Int             @id @default(autoincrement())
  requestId         Int
  activeRequestId   Int?            @unique
  employeeId        Int
  assignedByUserId  Int?
  isActive          Boolean         @default(true)
  status            TaskStatus      @default(ASSIGNED)
  assignedAt        DateTime        @default(now())
  acceptedAt        DateTime        @default(now())
  acknowledgedAt    DateTime?
  unassignedAt      DateTime?
  startedAt         DateTime?
  completedAt       DateTime?
  photosSubmittedAt DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  request           ServiceRequest  @relation(fields: [requestId], references: [id], onDelete: Restrict)
  employee          EmployeeProfile @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  assignedBy        User?           @relation("TaskAssignedBy", fields: [assignedByUserId], references: [id], onDelete: SetNull)
  photos            TaskPhoto[]
  operation         Operation?

  @@index([employeeId])
  @@index([requestId, isActive])
  @@index([assignedByUserId])
  @@index([status])
}

model Advertisement {
  id           String   @id @default(cuid())
  title        String
  imageUrl     String
  description  String?  @db.VarChar(500)
  linkUrl      String?
  startsAt     DateTime?
  endsAt       DateTime?
  isActive     Boolean  @default(false)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isActive, startsAt, endsAt])
  @@index([displayOrder])
}

model TaskPhoto {
  id                  Int              @id @default(autoincrement())
  taskAssignmentId    Int
  imageUrl            String
  caption             String?
  isApprovedForPublic Boolean          @default(false)
  uploadedAt          DateTime         @default(now())
  reviewedAt          DateTime?
  reviewedByAdminId   Int?
  taskAssignment      TaskAssignment   @relation(fields: [taskAssignmentId], references: [id], onDelete: Restrict)
  reviewedByAdmin     User?            @relation("TaskPhotoReviewer", fields: [reviewedByAdminId], references: [id], onDelete: SetNull)
  operationPhotos     OperationPhoto[]

  @@index([taskAssignmentId, uploadedAt])
  @@index([isApprovedForPublic])
  @@index([reviewedByAdminId])
}

model Operation {
  id               Int              @id @default(autoincrement())
  taskAssignmentId Int?             @unique
  title            String
  shortDescription String           @db.VarChar(500)
  description      String?          @db.Text
  serviceType      String
  area             String
  operationDate    DateTime
  isPublished      Boolean          @default(false)
  publishedAt      DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  taskAssignment   TaskAssignment?  @relation(fields: [taskAssignmentId], references: [id], onDelete: Restrict)
  photos           OperationPhoto[]

  @@index([isPublished, operationDate])
  @@index([createdAt])
}

model OperationPhoto {
  id           Int       @id @default(autoincrement())
  operationId  Int
  taskPhotoId  Int
  displayOrder Int       @default(0)
  operation    Operation @relation(fields: [operationId], references: [id], onDelete: Cascade)
  taskPhoto    TaskPhoto @relation(fields: [taskPhotoId], references: [id], onDelete: Restrict)

  @@unique([operationId, taskPhotoId])
  @@index([operationId, displayOrder])
  @@index([taskPhotoId])
}
